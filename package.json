{
  "name": "meded",
  "version": "1.0.0",
  "description": "Evidence-Based Medical Education, Structured for Deep & Comfortable Learning",
  "scripts": {
    "build:css": "npx tailwindcss -i src/styles.css -o assets/css/main.min.css --minify",
    "watch:css": "npx tailwindcss -i src/styles.css -o assets/css/main.min.css --watch",
    "validate": "python3 scripts/validate.py",
    "build": "npm run build:css && npm run validate"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  },
  "license": "MIT"
}
